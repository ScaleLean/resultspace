{
  "name": "resultspace",
  "version": "0.3.0",
  "description": "Each company's work, journal, knowledge and skills, kept apart from every other company. Agents write it; people check it on a phone; a built-in Curator keeps it true.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && node --test test/*.test.ts",
    "build": "cd web && vite build",
    "check:web": "cd web && svelte-kit sync && npx -y -p svelte-check@4 -p typescript@6 svelte-check --tsconfig tsconfig.check.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sveltejs/adapter-node": "^6",
    "@sveltejs/kit": "^3",
    "@sveltejs/vite-plugin-svelte": "^7",
    "@types/node": "^26.0.0",
    "svelte": "^5.57",
    "typescript": "7.0.2",
    "vite": "^8"
  },
  "overrides": {
    "@sveltejs/kit": {
      "typescript": "$typescript"
    }
  },
  "bin": {
    "resultspace": "src/local.ts",
    "rs": "src/cli/rs.ts"
  },
  "files": [
    "src",
    "build",
    "LICENSE",
    "README.md"
  ],
  "repository": "github.com/ScaleLean/resultspace"
}
